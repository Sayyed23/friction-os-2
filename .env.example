# Copy to .env.local and add the API key from the FrictionOS-MVP project.
# Keep the key server-side; never use a NEXT_PUBLIC_ prefix.
OPENAI_API_KEY=your_project_api_key_here
OPENAI_MODEL=gpt-5.6-luna

# Optional OpenRouter key for Grok, Gemini, and Claude model routing.
# Keep this server-side; never use a NEXT_PUBLIC_ prefix.
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Google OAuth web application credentials. Register /api/google/callback as an authorized redirect URI.
GOOGLE_CLIENT_ID=your_google_oauth_client_id
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret
# Optional; set this to your public app URL in production.
# GOOGLE_REDIRECT_URI=http://localhost:3000/api/google/callback

# Google Picker (enable the Google Picker API; restrict this key to your app).
NEXT_PUBLIC_GOOGLE_API_KEY=your_google_picker_api_key
NEXT_PUBLIC_GOOGLE_PROJECT_NUMBER=your_google_cloud_project_number
